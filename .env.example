# ─── Core ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://sdg:sdg@localhost:5432/sdg_impact_hub?schema=public"

# Public base URL of the app (used in emails and redirects)
APP_URL="http://localhost:3000"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Set to true when running behind a proxy / on Vercel
AUTH_TRUST_HOST=true

# ─── Google sign-in (optional) ───────────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Email (optional) ────────────────────────────────────────────────────
# Without SMTP settings, emails are printed to the server console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SDG Impact Hub <no-reply@sdgimpacthub.org>"

# ─── AI assistant (optional) ─────────────────────────────────────────────
# Without a key the assistant runs in "offline mode": answers come from
# platform data and built-in SDG knowledge instead of a language model.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional: any OpenAI-compatible provider. For Google Gemini's free tier use
# OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# with a Gemini API key from https://aistudio.google.com and a Gemini model name.
OPENAI_BASE_URL=""

# ─── File storage (optional) ─────────────────────────────────────────────
# Without Supabase settings, uploads are stored on local disk in ./uploads
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# ─── Maps ────────────────────────────────────────────────────────────────
# Tile server for Leaflet / OpenStreetMap. Use your own provider in production.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# ─── Display ─────────────────────────────────────────────────────────────
# IANA timezone used to display event times
NEXT_PUBLIC_APP_TIMEZONE="Asia/Bangkok"
